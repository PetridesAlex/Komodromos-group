{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "komodromosgroup.com" }],
      "destination": "https://www.komodromosgroup.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|sitemap\\.xml|robots\\.txt|seo-allowlist\\.json|assets/|images/|favicon\\.svg|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
