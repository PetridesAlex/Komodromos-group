{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "komodromosgroup.com" }],
      "destination": "https://www.komodromosgroup.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "global-wings.co" }],
      "destination": "https://www.global-wings.co/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "taxnexcy.com" }],
      "destination": "https://www.taxnexcy.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "astrealdevelopers.com" }],
      "destination": "https://www.astrealdevelopers.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|sitemap\\.xml|sitemap-.*\\.xml|robots\\.txt|seo-allowlist\\.json|assets/|images/|favicon\\.ico|favicon-.*\\.png|apple-touch-icon\\.png|android-chrome-.*\\.png|site\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}
