# JCC Payment Gateway (server-side only — set in Vercel Environment Variables for production)
# Copy this file to `.env` for local testing with `npx vercel dev` — never commit `.env`.
JCC_API_URL=https://gateway.jcc.com.cy/payment/rest/register.do
JCC_API_USERNAME=
JCC_API_PASSWORD=
JCC_CURRENCY=978
JCC_LANGUAGE=en
JCC_SUCCESS_URL=https://komodromos-group.vercel.app/payment-success
JCC_FAILED_URL=https://komodromos-group.vercel.app/payment-failed
JCC_CALLBACK_URL=https://komodromos-group.vercel.app/api/jcc-callback

# Frontend: enable JCC redirect when Stripe checkout URLs are not set
VITE_JCC_PAYMENTS_ENABLED=true

# Optional Stripe Payment Links (if set, used instead of JCC for that plan)
# VITE_TAX_CHECKOUT_DIY=
# VITE_TAX_CHECKOUT_ADVISOR=
# VITE_TAX_CHECKOUT_SELF_EMPLOYED=

# Resend — contact form emails (server-side only; set in Vercel Environment Variables)
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@komodromosgroup.com
# Use a verified domain sender once komodromosgroup.com is added in Resend, e.g.:
# RESEND_FROM=Komodromos Group <noreply@komodromosgroup.com>
RESEND_FROM=Komodromos Group <onboarding@resend.dev>
