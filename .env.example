# Resend — all website form submissions (server-side only; set in Vercel Environment Variables)
#
# REQUIRED for production (forms → info@komodromosgroup.com):
# 1. Create / use a Resend account at https://resend.com
# 2. Add domain komodromosgroup.com at https://resend.com/domains
# 3. Add the DNS records Resend gives you (SPF, DKIM) at your domain host
# 4. Wait until the domain shows "Verified"
# 5. Create an API key and set the variables below in Vercel (Production)
#
# Without a verified domain, Resend only allows test sends to the account owner email —
# NOT to info@komodromosgroup.com. That causes the error visitors may see on submit.
#
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@komodromosgroup.com
RESEND_FROM=Komodromos Group <notifications@komodromosgroup.com>
