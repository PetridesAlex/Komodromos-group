# Optional Stripe Payment Links for TaxNex plan checkout
# VITE_TAX_CHECKOUT_DIY=
# VITE_TAX_CHECKOUT_ADVISOR=
# VITE_TAX_CHECKOUT_SELF_EMPLOYED=

# Resend — all website form submissions (server-side only; set in Vercel Environment Variables)
#
# REQUIRED for production (forms → info@komodromosgroup.com):
# 1. Create / use a Resend account at https://resend.com
# 2. Add domain komodromosgroup.com at https://resend.com/domains
# 3. Add the DNS records Resend gives you (SPF, DKIM) at your domain host
# 4. Wait until the domain shows "Verified"
# 5. Create an API key and set the variables below in Vercel (Production)
#
# Without a verified domain, Resend only allows test sends to the account owner email —
# NOT to info@komodromosgroup.com. That causes the error visitors may see on submit.
#
# CV uploads on /services/aviation/jobs use the same variables via /api/send-cv-application.
#
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@komodromosgroup.com
RESEND_FROM=Komodromos Group <info@komodromosgroup.com>

# Cloudflare Turnstile — spam protection for all form → Resend pipelines
#
# REQUIRED for production anti-spam (recommended):
# 1. Create a free Turnstile widget at https://dash.cloudflare.com → Turnstile
# 2. Widget mode: Managed or Invisible
# 3. Add every live hostname that hosts forms, e.g.:
#    - www.komodromosgroup.com / komodromosgroup.com
#    - www.janchapelle.com / janchapelle.com
#    - www.global-wings.co / global-wings.co
#    - www.taxnexcy.com / taxnexcy.com
#    - www.astrealdevelopers.com / astrealdevelopers.com
#    - www.bluesky-pools.com / bluesky-pools.com
#    - www.weddingskycy.com / weddingskycy.com
#    - www.adrcentercy.com / adrcentercy.com
# 4. Copy the Site Key and Secret Key into Vercel (Production + Preview):
#
# VITE_TURNSTILE_SITE_KEY is public (bundled into the client).
# TURNSTILE_SECRET_KEY is server-only (never expose to Vite / VITE_ prefix).
#
# If TURNSTILE_SECRET_KEY is unset, the API skips Turnstile (dev/local) and still
# applies honeypot / timing / content heuristics.
#
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
