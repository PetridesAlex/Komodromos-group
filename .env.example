# JCC Payment Gateway (server-side only — set in Vercel Environment Variables for production)
JCC_API_URL=https://gateway.jcc.com.cy/payment/rest/register.do
JCC_API_USERNAME=
JCC_API_PASSWORD=
JCC_CURRENCY=978
JCC_LANGUAGE=en
JCC_SUCCESS_URL=https://YOURDOMAIN.com/payment-success
JCC_FAILED_URL=https://YOURDOMAIN.com/payment-failed
JCC_CALLBACK_URL=https://YOURDOMAIN.com/api/jcc-callback

# Frontend: enable JCC redirect when Stripe checkout URLs are not set
VITE_JCC_PAYMENTS_ENABLED=true

# Optional Stripe Payment Links (if set, used instead of JCC for that plan)
# VITE_TAX_CHECKOUT_DIY=
# VITE_TAX_CHECKOUT_ADVISOR=
# VITE_TAX_CHECKOUT_SELF_EMPLOYED=
